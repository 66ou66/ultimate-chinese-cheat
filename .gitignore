# ============================================
# 终极象棋外挂项目 - Git 忽略文件 (.gitignore)
# 被此文件列出的内容不会上传到 GitHub
# ============================================

# ----- Python 运行缓存 -----
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ----- Python 虚拟环境（体积巨大，绝不上传）-----
.venv/
venv/
env/
ENV/

# ----- IDE / 编辑器配置 -----
.idea/
.vscode/
*.iml

# ----- 大型模型文件（体积大，别人需要自己训练）-----
*.pt
*.pth
*.onnx
*.ckpt
*.h5
*.pb

# ----- 象棋引擎（可执行程序，体积大）-----
engine/
*.exe
*.dll

# ----- 旧备份副本 / 独立嵌套仓库 -----
ai象棋外挂项目pro - 副本/
给fen得出建议/

# ----- 本地运行配置（可能含 API 密钥，绝不上传）-----
ai_settings.json

# ----- 日志与临时文件 -----
*.log
*.tmp
*.temp
Thumbs.db

# ----- 本机调试 / 坐标配置（不上传）-----
coin_click.json
对手应着
